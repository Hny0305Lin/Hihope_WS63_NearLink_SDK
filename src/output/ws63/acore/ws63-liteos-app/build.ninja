# =============================================================================
# Link build statements for STATIC_LIBRARY target at


#############################################
# Link the static library utils\at\at\libat.a

build utils/at/at/libat.a: C_STATIC_LIBRARY_LINKER__at_ utils/at/at/CMakeFiles/at.dir/src/at_cmd.c.obj utils/at/at/CMakeFiles/at.dir/src/at_msg.c.obj utils/at/at/CMakeFiles/at.dir/src/at_parse.c.obj utils/at/at/CMakeFiles/at.dir/src/at_channel.c.obj utils/at/at/CMakeFiles/at.dir/src/at_process.c.obj utils/at/at/CMakeFiles/at.dir/src/at_report.c.obj utils/at/at/CMakeFiles/at.dir/src/at_base.c.obj utils/at/at/CMakeFiles/at.dir/src/at_notify.c.obj utils/at/at/CMakeFiles/at.dir/src/at_zdiag.c.obj
  OBJECT_DIR = utils\at\at\CMakeFiles\at.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = utils\at\at\CMakeFiles\at.dir\at.pdb
  TARGET_FILE = utils\at\at\libat.a
  TARGET_PDB = utils\at\at\libat.pdb


#############################################
# Utility command for edit_cache

build utils/at/at/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\utils\at\at && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build utils/at/at/edit_cache: phony utils/at/at/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build utils/at/at/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\utils\at\at && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build utils/at/at/rebuild_cache: phony utils/at/at/CMakeFiles/rebuild_cache.util

# =============================================================================
# Write statements declared in CMakeLists.txt:
# C:/dsc/src/middleware/utils/at/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for STATIC_LIBRARY target wifi_at


#############################################
# Order-only phony target for wifi_at

