# Link the static library drivers\chips\ws63\porting\liteos\libliteos_port.a

build drivers/chips/ws63/porting/liteos/libliteos_port.a: C_STATIC_LIBRARY_LINKER__liteos_port_ drivers/chips/ws63/porting/liteos/CMakeFiles/liteos_port.dir/riscv31/idle_config.c.obj drivers/chips/ws63/porting/liteos/CMakeFiles/liteos_port.dir/riscv31/tick_timer.c.obj
  OBJECT_DIR = drivers\chips\ws63\porting\liteos\CMakeFiles\liteos_port.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = drivers\chips\ws63\porting\liteos\CMakeFiles\liteos_port.dir\liteos_port.pdb
  TARGET_FILE = drivers\chips\ws63\porting\liteos\libliteos_port.a
  TARGET_PDB = drivers\chips\ws63\porting\liteos\libliteos_port.pdb


#############################################
# Utility command for edit_cache

build drivers/chips/ws63/porting/liteos/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\drivers\chips\ws63\porting\liteos && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build drivers/chips/ws63/porting/liteos/edit_cache: phony drivers/chips/ws63/porting/liteos/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build drivers/chips/ws63/porting/liteos/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\drivers\chips\ws63\porting\liteos && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build drivers/chips/ws63/porting/liteos/rebuild_cache: phony drivers/chips/ws63/porting/liteos/CMakeFiles/rebuild_cache.util

