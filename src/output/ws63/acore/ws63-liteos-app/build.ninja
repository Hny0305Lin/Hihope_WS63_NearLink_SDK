# =============================================================================
# Link build statements for STATIC_LIBRARY target hal_pmp


#############################################
# Link the static library hal\pmp\libhal_pmp.a

build hal/pmp/libhal_pmp.a: C_STATIC_LIBRARY_LINKER__hal_pmp_ hal/pmp/CMakeFiles/hal_pmp.dir/hal_pmp.c.obj hal/pmp/CMakeFiles/hal_pmp.dir/v31/hal_pmp_riscv31.c.obj hal/pmp/CMakeFiles/hal_pmp.dir/v31/hal_pmp_riscv31_regs_op.c.obj
  OBJECT_DIR = hal\pmp\CMakeFiles\hal_pmp.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = hal\pmp\CMakeFiles\hal_pmp.dir\hal_pmp.pdb
  TARGET_FILE = hal\pmp\libhal_pmp.a
  TARGET_PDB = hal\pmp\libhal_pmp.pdb


#############################################
# Utility command for edit_cache

build hal/pmp/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\hal\pmp && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build hal/pmp/edit_cache: phony hal/pmp/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build hal/pmp/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\hal\pmp && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build hal/pmp/rebuild_cache: phony hal/pmp/CMakeFiles/rebuild_cache.util

# =============================================================================
# Write statements declared in CMakeLists.txt:
# C:/dsc/src/drivers/drivers/hal/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for STATIC_LIBRARY target hal_pwm


#############################################
# Order-only phony target for hal_pwm

build cmake_object_order_depends_target_hal_pwm: phony || .

