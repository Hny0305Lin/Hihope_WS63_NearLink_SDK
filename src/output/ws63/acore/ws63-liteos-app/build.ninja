  OBJECT_DIR = driver\tsensor\CMakeFiles\tsensor.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = driver\tsensor\CMakeFiles\tsensor.dir\tsensor.pdb
  TARGET_FILE = driver\tsensor\libtsensor.a
  TARGET_PDB = driver\tsensor\libtsensor.pdb


#############################################
# Utility command for edit_cache

build driver/tsensor/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\driver\tsensor && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build driver/tsensor/edit_cache: phony driver/tsensor/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build driver/tsensor/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\driver\tsensor && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build driver/tsensor/rebuild_cache: phony driver/tsensor/CMakeFiles/rebuild_cache.util

