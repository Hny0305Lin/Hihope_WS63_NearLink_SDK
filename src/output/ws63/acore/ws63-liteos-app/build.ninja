# =============================================================================
# Link build statements for STATIC_LIBRARY target hal_gpio_v150


#############################################
# Link the static library hal\gpio\libhal_gpio_v150.a

build hal/gpio/libhal_gpio_v150.a: C_STATIC_LIBRARY_LINKER__hal_gpio_v150_ hal/gpio/CMakeFiles/hal_gpio_v150.dir/hal_gpio.c.obj hal/gpio/CMakeFiles/hal_gpio_v150.dir/v150/hal_gpio_v150.c.obj hal/gpio/CMakeFiles/hal_gpio_v150.dir/v150/hal_gpio_v150_regs_op.c.obj hal/gpio/CMakeFiles/hal_gpio_v150.dir/v150/hal_gpio_v150_comm.c.obj
  OBJECT_DIR = hal\gpio\CMakeFiles\hal_gpio_v150.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = hal\gpio\CMakeFiles\hal_gpio_v150.dir\hal_gpio_v150.pdb
  TARGET_FILE = hal\gpio\libhal_gpio_v150.a
  TARGET_PDB = hal\gpio\libhal_gpio_v150.pdb


#############################################
# Utility command for edit_cache

build hal/gpio/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\hal\gpio && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build hal/gpio/edit_cache: phony hal/gpio/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build hal/gpio/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\hal\gpio && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build hal/gpio/rebuild_cache: phony hal/gpio/CMakeFiles/rebuild_cache.util

# =============================================================================
# Write statements declared in CMakeLists.txt:
# C:/dsc/src/drivers/drivers/hal/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for STATIC_LIBRARY target hal_i2c


#############################################
# Order-only phony target for hal_i2c

