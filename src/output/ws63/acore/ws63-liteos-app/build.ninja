# =============================================================================
# Link build statements for STATIC_LIBRARY target adc


#############################################
# Link the static library driver\adc\libadc.a

build driver/adc/libadc.a: C_STATIC_LIBRARY_LINKER__adc_ driver/adc/CMakeFiles/adc.dir/adc.c.obj
  OBJECT_DIR = driver\adc\CMakeFiles\adc.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = driver\adc\CMakeFiles\adc.dir\adc.pdb
  TARGET_FILE = driver\adc\libadc.a
  TARGET_PDB = driver\adc\libadc.pdb


#############################################
# Utility command for edit_cache

build driver/adc/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\driver\adc && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build driver/adc/edit_cache: phony driver/adc/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build driver/adc/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\driver\adc && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build driver/adc/rebuild_cache: phony driver/adc/CMakeFiles/rebuild_cache.util

