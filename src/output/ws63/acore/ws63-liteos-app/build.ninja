  OBJECT_DIR = driver\pmp\CMakeFiles\pmp.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = driver\pmp\CMakeFiles\pmp.dir\pmp.pdb
  TARGET_FILE = driver\pmp\libpmp.a
  TARGET_PDB = driver\pmp\libpmp.pdb


#############################################
# Utility command for edit_cache

build driver/pmp/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\driver\pmp && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build driver/pmp/edit_cache: phony driver/pmp/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build driver/pmp/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\driver\pmp && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build driver/pmp/rebuild_cache: phony driver/pmp/CMakeFiles/rebuild_cache.util

