# Link build statements for STATIC_LIBRARY target hal_adc


#############################################
# Link the static library hal\adc\libhal_adc.a

build hal/adc/libhal_adc.a: C_STATIC_LIBRARY_LINKER__hal_adc_ hal/adc/CMakeFiles/hal_adc.dir/hal_adc.c.obj hal/adc/CMakeFiles/hal_adc.dir/v154/hal_adc_v154.c.obj hal/adc/CMakeFiles/hal_adc.dir/v154/hal_adc_v154_regs_op.c.obj
  OBJECT_DIR = hal\adc\CMakeFiles\hal_adc.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = hal\adc\CMakeFiles\hal_adc.dir\hal_adc.pdb
  TARGET_FILE = hal\adc\libhal_adc.a
  TARGET_PDB = hal\adc\libhal_adc.pdb


#############################################
# Utility command for edit_cache

build hal/adc/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\hal\adc && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build hal/adc/edit_cache: phony hal/adc/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build hal/adc/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\hal\adc && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build hal/adc/rebuild_cache: phony hal/adc/CMakeFiles/rebuild_cache.util

