# Link the static library hal\tsensor\libhal_tsensor.a

build hal/tsensor/libhal_tsensor.a: C_STATIC_LIBRARY_LINKER__hal_tsensor_ hal/tsensor/CMakeFiles/hal_tsensor.dir/hal_tsensor.c.obj hal/tsensor/CMakeFiles/hal_tsensor.dir/v151/hal_tsensor_v151.c.obj hal/tsensor/CMakeFiles/hal_tsensor.dir/v151/hal_tsensor_v151_regs_op.c.obj
  OBJECT_DIR = hal\tsensor\CMakeFiles\hal_tsensor.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = hal\tsensor\CMakeFiles\hal_tsensor.dir\hal_tsensor.pdb
  TARGET_FILE = hal\tsensor\libhal_tsensor.a
  TARGET_PDB = hal\tsensor\libhal_tsensor.pdb


#############################################
# Utility command for edit_cache

build hal/tsensor/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\hal\tsensor && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build hal/tsensor/edit_cache: phony hal/tsensor/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build hal/tsensor/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\hal\tsensor && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build hal/tsensor/rebuild_cache: phony hal/tsensor/CMakeFiles/rebuild_cache.util

