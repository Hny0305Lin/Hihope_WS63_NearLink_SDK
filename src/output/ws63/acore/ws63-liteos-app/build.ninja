# =============================================================================
# Link build statements for STATIC_LIBRARY target gpio


#############################################
# Link the static library driver\gpio\libgpio.a

build driver/gpio/libgpio.a: C_STATIC_LIBRARY_LINKER__gpio_ driver/gpio/CMakeFiles/gpio.dir/gpio.c.obj
  OBJECT_DIR = driver\gpio\CMakeFiles\gpio.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = driver\gpio\CMakeFiles\gpio.dir\gpio.pdb
  TARGET_FILE = driver\gpio\libgpio.a
  TARGET_PDB = driver\gpio\libgpio.pdb


#############################################
# Utility command for edit_cache

build driver/gpio/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\driver\gpio && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build driver/gpio/edit_cache: phony driver/gpio/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build driver/gpio/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\dsc\src\output\ws63\acore\ws63-liteos-app\driver\gpio && D:\anaconda\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\dsc\src -BC:\dsc\src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build driver/gpio/rebuild_cache: phony driver/gpio/CMakeFiles/rebuild_cache.util

# =============================================================================
# Write statements declared in CMakeLists.txt:
# C:/dsc/src/drivers/drivers/driver/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for STATIC_LIBRARY target i2c


#############################################
# Order-only phony target for i2c

